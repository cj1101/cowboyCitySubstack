rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userPath());
    }

    function hasUser() {
      return isSignedIn() && exists(userPath());
    }

    // Root sheriffs. Additional emails can live on config/admins { emails: string[] }.
    function rootAdminEmails() {
      return ['charlie@suarezhouse.net', 'cjtheswimmer1101@gmail.com'];
    }

    function authEmail() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isRootAdmin() {
      return authEmail() in rootAdminEmails();
    }

    function isConfigAdmin() {
      return authEmail() != '' &&
        exists(/databases/$(database)/documents/config/admins) &&
        authEmail() in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    function isAllowlisted() {
      return isRootAdmin() || isConfigAdmin();
    }

    function isAdmin() {
      return isAllowlisted() || (hasUser() && userDoc().data.isAdmin == true);
    }

    // Signed-in and not suspended or removed. Approval is off; to require it
    // again, also require status == 'approved' here and set REQUIRE_APPROVAL
    // in lib/membership.ts.
    function isSuspended() {
      return hasUser() && userDoc().data.status in ['suspended', 'removed'];
    }

    function isMember() {
      return isSignedIn() && !isSuspended();
    }

    function memberDocId(uid, factionId) {
      return uid + '_' + factionId;
    }

    function factionMemberPath(uid, factionId) {
      return /databases/$(database)/documents/faction_members/$(memberDocId(uid, factionId));
    }

    function isFactionOwner(factionId) {
      return isSignedIn() &&
        exists(factionMemberPath(request.auth.uid, factionId)) &&
        get(factionMemberPath(request.auth.uid, factionId)).data.role == 'owner';
    }

    // ownerUids is what the city page shows. Some cities were saved with that
    // list before the membership document existed, so either proof is enough.
    function ownsListedCity(cityId) {
      return isFactionOwner(cityId) || (
        cityId is string &&
        exists(/databases/$(database)/documents/factions/$(cityId)) &&
        get(/databases/$(database)/documents/factions/$(cityId)).data.get('ownerUids', []).hasAny([request.auth.uid])
      );
    }

    // --- Sim layer (Phase 1) ---------------------------------------------

    function userData() {
      return userDoc().data;
    }

    // Signed-in, has a user doc, not suspended/removed. Default-safe before
    // the Phase 8 guest pass: with no accessLevel field anywhere, every
    // viewer evaluates as a member — exactly today's behavior.
    function isViewer() {
      return isSignedIn() && hasUser() && !isSuspended();
    }

    function isGuestViewer() {
      return isViewer() && userData().get('accessLevel', 'member') == 'guest';
    }

    function isFullMember() {
      return isViewer() && userData().get('accessLevel', 'member') == 'member';
    }

    // Fabric service user (spec §5.9): custom claims on a dedicated Auth
    // service user. The Admin SDK bypasses these predicates entirely; they
    // bind the client-SDK/service-user path, which is the ongoing-play path.
    function isFabricService() {
      return isSignedIn()
        && request.auth.token.get('fabric', false) == true
        && request.auth.token.get('fabricRole', '') in ['committer', 'worker'];
    }

    function isFabricCommitter() {
      return isSignedIn()
        && request.auth.token.get('fabric', false) == true
        && request.auth.token.get('fabricRole', '') == 'committer';
    }

    function isFabricWorker() {
      return isSignedIn()
        && request.auth.token.get('fabric', false) == true
        && request.auth.token.get('fabricRole', '') == 'worker';
    }

    // Sim ownership proof reuses the existing faction proof order
    // (faction_members owner role, factions.ownerUids fallback). Never a
    // copied ownerUid field on a sim doc.
    function simCityOwner(cityId) {
      return isFullMember() && ownsListedCity(cityId);
    }

    function validNewLogEntry(entryId) {
      return request.resource.data.seq is int
        && request.resource.data.seq >= 1
        && request.resource.data.kind in
             ['action-summary', 'rule-effect', 'case', 'contest', 'rejected', 'genesis']
        && request.resource.data.visibility in ['public', 'actor-private']
        && request.resource.data.prevHash is string
        && request.resource.data.prevHash.size() == 64
        && request.resource.data.entryHash is string
        && request.resource.data.entryHash.size() == 64
        // Phase 2 (brief §9.1): v1 survives ONLY as the genesis carve-out —
        // the already-landed seq-1 entry must remain creatable-verifiable
        // in fixtures forever, and no second v1 entry may ever be written.
        // v2 requires the four Phase 2 fields, present with typed values on
        // every entry (Felix's no-optional-fields discipline).
        && ((request.resource.data.hashVersion == 'cowboy-canonical-json-v1'
             && request.resource.data.seq == 1
             && request.resource.data.kind == 'genesis'
             && request.resource.data.resolutionId == 'genesis')
            || (request.resource.data.hashVersion == 'cowboy-canonical-json-v2'
                && request.resource.data.keys().hasAll(
                     ['pendingId', 'wakeActionId', 'executedDuringSeq', 'generation'])
                && (request.resource.data.pendingId == null
                    || request.resource.data.pendingId is string)
                && (request.resource.data.wakeActionId == null
                    || request.resource.data.wakeActionId is string)
                && (request.resource.data.executedDuringSeq == null
                    || request.resource.data.executedDuringSeq is int)
                && (request.resource.data.generation == null
                    || request.resource.data.generation is map)));
    }

    function isFactionMember(factionId) {
      return isSignedIn() && exists(factionMemberPath(request.auth.uid, factionId));
    }

    function validStatus(status) {
      return status in ['pending', 'approved', 'denied', 'suspended', 'removed'];
    }

    function ownerSubmittingHtml() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['pendingHtml', 'htmlStatus', 'htmlSubmittedAt']) &&
        request.resource.data.htmlStatus == 'pending_review' &&
        request.resource.data.pendingHtml is string &&
        request.resource.data.pendingHtml.size() > 0 &&
        request.resource.data.pendingHtml.size() <= 500000;
    }

    function ownerUpdatingProfile() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['liveHtml', 'pendingHtml', 'htmlStatus', 'htmlSubmittedAt', 'htmlReviewedAt', 'ownerUids']);
    }

    // Civic fields live on the city document. Owners may set or clear them.
    function validCityFacts() {
      return (
        (
          !request.resource.data.keys().hasAny(['population']) ||
          request.resource.data.population == null ||
          (
            request.resource.data.population is int &&
            request.resource.data.population >= 0 &&
            request.resource.data.population <= 1000000000
          )
        ) &&
        (
          !request.resource.data.keys().hasAny(['motto']) ||
          request.resource.data.motto == null ||
          (
            request.resource.data.motto is string &&
            request.resource.data.motto.size() <= 180
          )
        ) &&
        (
          !request.resource.data.keys().hasAny(['foundedOn']) ||
          request.resource.data.foundedOn == null ||
          (
            request.resource.data.foundedOn is string &&
            request.resource.data.foundedOn.size() <= 32
          )
        ) &&
        (
          !request.resource.data.keys().hasAny(['gallery']) ||
          (
            request.resource.data.gallery is list &&
            request.resource.data.gallery.size() <= 24
          )
        )
      );
    }

    function validMinecraftName() {
      return !request.resource.data.keys().hasAny(['minecraftUsername']) ||
        request.resource.data.minecraftUsername == null ||
        (
          request.resource.data.minecraftUsername is string &&
          (
            request.resource.data.minecraftUsername.size() == 0 ||
            (
              request.resource.data.minecraftUsername.size() >= 3 &&
              request.resource.data.minecraftUsername.size() <= 16 &&
              request.resource.data.minecraftUsername.matches('^[A-Za-z0-9_]+$')
            )
          )
        );
    }

    function ownerManagingCoOwners(factionId) {
      return isFactionOwner(factionId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUids']) &&
        request.auth.uid in request.resource.data.ownerUids &&
        request.resource.data.ownerUids.size() >= 1 &&
        request.resource.data.ownerUids.size() <= 12;
    }

    function adminApprovingHtml() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['liveHtml', 'pendingHtml', 'htmlStatus', 'htmlReviewedAt']) &&
        request.resource.data.htmlStatus in ['approved', 'rejected'];
    }

    function validPollVote() {
      return resource.data.poll != null &&
        request.resource.data.poll != null &&
        request.resource.data.poll.question == resource.data.poll.question &&
        request.resource.data.poll.options == resource.data.poll.options &&
        request.resource.data.poll.votes.keys().hasOnly(
          resource.data.poll.votes.keys().union([request.auth.uid])
        ) &&
        request.resource.data.poll.votes[request.auth.uid] is int &&
        request.resource.data.poll.votes[request.auth.uid] >= 0 &&
        request.resource.data.poll.votes[request.auth.uid] < resource.data.poll.options.size();
    }

    function searchTokenPatch() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['searchTokens']) &&
        request.resource.data.searchTokens is list &&
        request.resource.data.searchTokens.size() > 0 &&
        request.resource.data.searchTokens.size() <= 80;
    }

    function validNewPost() {
      return isMember() &&
        isFactionMember(request.resource.data.factionId) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.type in ['announcement', 'build', 'lore', 'debate', 'event', 'wiki'] &&
        request.resource.data.status == 'published' &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 300 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() <= 200000 &&
        request.resource.data.cityIds is list &&
        request.resource.data.cityIds.size() >= 1 &&
        request.resource.data.cityIds.size() <= 12 &&
        request.resource.data.factionId in request.resource.data.cityIds &&
        request.resource.data.referencedPostIds is list &&
        request.resource.data.referencedPostIds.size() <= 20 &&
        request.resource.data.spoiler is bool &&
        (request.resource.data.pinned == false || isAdmin());
    }

    function preservesPostIdentity() {
      return request.resource.data.factionId == resource.data.factionId &&
        request.resource.data.authorUid == resource.data.authorUid &&
        request.resource.data.pinned == resource.data.pinned;
    }

    function bootstrappingOwnMembership(memberId) {
      return isMember() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'owner' &&
        request.resource.data.factionId is string &&
        memberId == request.auth.uid + '_' + request.resource.data.factionId &&
        exists(/databases/$(database)/documents/factions/$(request.resource.data.factionId)) &&
        get(/databases/$(database)/documents/factions/$(request.resource.data.factionId)).data.ownerUids.hasAny([request.auth.uid]);
    }

    function keepsIdentity() {
      return request.resource.data.email == resource.data.email &&
        request.resource.data.isAdmin == resource.data.isAdmin &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.get('ownsCity', false) == resource.data.get('ownsCity', false);
    }

    function isCityOwner() {
      return hasUser() && userDoc().data.get('ownsCity', false) == true;
    }

    function pinCategoryOk() {
      return !request.resource.data.keys().hasAny(['category']) ||
        request.resource.data.category in ['capital', 'outpost', 'landmark', 'other'];
    }

    function claimCityOwner(uid) {
      return request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownsCity', 'proofCityId']) &&
        request.resource.data.ownsCity == true &&
        request.resource.data.proofCityId is string &&
        isFactionOwner(request.resource.data.proofCityId);
    }

    function selfPromoteAllowlisted(uid) {
      return request.auth.uid == uid &&
        isAllowlisted() &&
        request.resource.data.isAdmin == true &&
        request.resource.data.status == 'approved' &&
        request.resource.data.email == resource.data.email;
    }

    function acceptOwnInvite(uid) {
      return request.auth.uid == uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'approved' &&
        request.resource.data.isAdmin == resource.data.isAdmin &&
        request.resource.data.email == resource.data.email &&
        authEmail() != '' &&
        exists(/databases/$(database)/documents/invites/$(authEmail())) &&
        get(/databases/$(database)/documents/invites/$(authEmail())).data.status != 'revoked';
    }

    // Lets a new account leave "pending" without touching isAdmin. The July
    // rules already allow this. The combined isAdmin write does not.
    function claimOpenMembership(uid) {
      return request.auth.uid == uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'approved' &&
        request.resource.data.isAdmin == resource.data.isAdmin &&
        request.resource.data.email == resource.data.email;
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if docId == 'admins' && isAdmin() &&
        request.resource.data.emails is list &&
        request.resource.data.emails.size() <= 50;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isMember() || isAdmin());
      allow create: if isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.isAdmin == false &&
        request.resource.data.status in ['pending', 'approved'] &&
        request.resource.data.email is string &&
        request.resource.data.email.lower() == authEmail() &&
        validMinecraftName();
      allow update: if isSignedIn() && (
        (isAdmin() && request.auth.uid != uid && validStatus(request.resource.data.status)) ||
        selfPromoteAllowlisted(uid) ||
        acceptOwnInvite(uid) ||
        claimOpenMembership(uid) ||
        claimCityOwner(uid) ||
        (request.auth.uid == uid && keepsIdentity() && validMinecraftName())
      );
      allow delete: if isAdmin() && request.auth.uid != uid;

      match /reads/{conversationId} {
        allow read, write: if isMember() && request.auth.uid == uid;
      }
    }

    match /invites/{inviteId} {
      allow read: if isAdmin() ||
        (authEmail() != '' && inviteId == authEmail());
      allow create: if isAdmin() &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 3 &&
        request.resource.data.email.size() < 200 &&
        inviteId == request.resource.data.email.lower();
      allow update: if isAdmin() ||
        (authEmail() != '' &&
          inviteId == authEmail() &&
          resource.data.status != 'revoked' &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedUid']));
      allow delete: if isAdmin();
    }

    match /factions/{factionId} {
      allow read: if isMember();
      allow create: if isMember() &&
        request.resource.data.ownerUids is list &&
        request.resource.data.ownerUids.size() >= 1 &&
        request.resource.data.ownerUids.size() <= 12 &&
        request.auth.uid in request.resource.data.ownerUids &&
        request.resource.data.name is string &&
        request.resource.data.slug is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        validCityFacts();
      allow update: if isAdmin() || (
        isMember() &&
        ownsListedCity(factionId) &&
        (
          (ownerUpdatingProfile() && validCityFacts()) ||
          ownerSubmittingHtml() ||
          ownerManagingCoOwners(factionId)
        )
      );
      allow delete: if isAdmin();

      match /pins/{pinId} {
        allow read: if isMember();
        allow create, update: if isMember() &&
          (isAdmin() || isFactionOwner(factionId)) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 200 &&
          request.resource.data.nx is number &&
          request.resource.data.ny is number &&
          pinCategoryOk();
        allow delete: if isMember() && (isAdmin() || isFactionOwner(factionId));
      }
    }

    match /characters/{characterId} {
      allow read: if isMember();
      allow create: if isMember() && isFactionOwner(request.resource.data.factionId);
      allow update: if isMember() && isFactionOwner(request.resource.data.factionId);
      allow delete: if isMember() && (isFactionOwner(resource.data.factionId) || isAdmin());
    }

    match /faction_members/{memberId} {
      allow read: if isMember();
      allow create: if isAdmin() ||
        (isMember() && isFactionOwner(request.resource.data.factionId)) ||
        bootstrappingOwnMembership(memberId);
      allow update: if isAdmin() ||
        (isMember() && isFactionOwner(request.resource.data.factionId));
      allow delete: if isAdmin() ||
        (isMember() && isFactionOwner(resource.data.factionId));
    }

    function emojiReactionCreate(reactionId) {
      return isMember() &&
        request.resource.data.keys().hasOnly(['uid', 'emoji']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.emoji is string &&
        request.resource.data.emoji in ['heart', 'pickaxe', 'diamond', 'emerald', 'blaze', 'crown'] &&
        reactionId == request.auth.uid + '_' + request.resource.data.emoji;
    }

    function emojiReactionDelete() {
      return isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
    }

    match /posts/{postId} {
      // Missing status is a legacy published post. Drafts live in /drafts so this
      // collection can be listed without a status filter.
      allow read: if isAdmin() || isMember();
      allow create: if validNewPost();
      allow update: if (isMember() || isAdmin()) && (
        (isAdmin() && searchTokenPatch()) ||
        (isAdmin() && preservesPostIdentity()) ||
        ((resource.data.authorUid == request.auth.uid || isFactionOwner(resource.data.factionId)) &&
          preservesPostIdentity()) ||
        (validPollVote() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll', 'updatedAt']))
      );
      allow delete: if (isMember() || isAdmin()) &&
        (isAdmin() || isFactionOwner(resource.data.factionId) || resource.data.authorUid == request.auth.uid);

      match /replies/{replyId} {
        allow read: if isMember();
        allow create: if isMember() &&
          isFactionMember(request.resource.data.factionId) &&
          request.resource.data.stance in ['for', 'against', 'neutral'] &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 8000 &&
          request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isMember() &&
          (isFactionOwner(resource.data.factionId) || isAdmin() || resource.data.authorUid == request.auth.uid);
      }

      match /reactions/{uid} {
        allow read: if isMember();
        allow create, update: if isMember() &&
          request.auth.uid == uid &&
          request.resource.data.type in ['agrees', 'disputes', 'witnessed'];
        allow delete: if isMember() && (request.auth.uid == uid || isAdmin());
      }

      // One document per person per emoji. The id is uid + "_" + emoji.
      match /emoji_reactions/{reactionId} {
        allow read: if isMember();
        allow create: if emojiReactionCreate(reactionId) &&
          exists(/databases/$(database)/documents/posts/$(postId));
        allow delete: if emojiReactionDelete();
      }

      match /comments/{commentId} {
        allow read: if isMember();
        allow create: if isMember() &&
          exists(/databases/$(database)/documents/posts/$(postId)) &&
          request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'body', 'createdAt']) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorName is string &&
          request.resource.data.authorName.size() > 0 &&
          request.resource.data.authorName.size() <= 80 &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 2000 &&
          request.resource.data.createdAt is timestamp;
        allow delete: if isAdmin() || (isMember() && resource.data.authorUid == request.auth.uid);
      }
    }

    match /drafts/{postId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid) ||
        (isMember() && resource.data.keys().hasAll(['factionId']) && isFactionOwner(resource.data.factionId));
      allow create: if isMember() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.status in ['draft', 'scheduled'] &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 300 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() <= 200000;
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid) ||
        (isMember() && resource.data.keys().hasAll(['factionId']) && isFactionOwner(resource.data.factionId));
    }

    match /wiki/{factionId} {
      allow read: if isMember();
      allow write: if isMember() && (isFactionOwner(factionId) || isAdmin());

      match /wiki_sections/{sectionId} {
        allow read: if isMember();
        allow write: if isMember() && (isFactionOwner(factionId) || isAdmin());
      }
    }

    match /wiki_entries/{entryId} {
      allow read: if isMember();
      allow create, update: if isMember() &&
        isFactionOwner(request.resource.data.cityId) &&
        request.resource.data.kind in ['character', 'place', 'faction', 'law', 'species', 'team'] &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 160 &&
        request.resource.data.slug is string &&
        request.resource.data.body is string &&
        request.resource.data.body.size() <= 200000;
      allow update: if isAdmin() && searchTokenPatch();
      allow delete: if isMember() && (isAdmin() || isFactionOwner(resource.data.cityId));
    }

    match /follows/{followId} {
      allow read: if isMember();
      allow create: if isMember() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.cityId is string &&
        followId == request.auth.uid + '_' + request.resource.data.cityId;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    match /eras/{eraId} {
      allow read: if isMember();
      allow create, update: if isMember() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80;
      allow delete: if isAdmin();
    }

    function borderPointOk(point) {
      return point is map &&
        point.keys().hasOnly(['nx', 'ny']) &&
        point.nx is number &&
        point.ny is number &&
        point.nx >= 0 &&
        point.nx <= 1 &&
        point.ny >= 0 &&
        point.ny <= 1;
    }

    function validCityBorder(cityId) {
      return request.resource.data.keys().hasOnly(['cityId', 'points', 'updatedAt']) &&
        request.resource.data.cityId == cityId &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.points is list &&
        request.resource.data.points.size() >= 3 &&
        request.resource.data.points.size() <= 64 &&
        borderPointOk(request.resource.data.points[0]) &&
        borderPointOk(request.resource.data.points[1]) &&
        borderPointOk(request.resource.data.points[2]) &&
        borderPointOk(request.resource.data.points[request.resource.data.points.size() - 1]);
    }

    match /realm_map/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();

      match /pins/{pinId} {
        allow read: if isMember();
        allow create, update: if isAdmin() &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.nx is number &&
          request.resource.data.ny is number &&
          pinCategoryOk();
        allow delete: if isAdmin();
      }

      // One border document per city. Signed-in readers; only that city's owner or an admin can write.
      match /borders/{cityId} {
        allow read: if isSignedIn();
        allow create, update: if validCityBorder(cityId) &&
          (isAdmin() || (isMember() && ownsListedCity(cityId)));
        allow delete: if isAdmin() || (isMember() && ownsListedCity(cityId));
      }
    }

    match /conversations/{conversationId} {
      allow get: if resource == null ||
        (isMember() && request.auth.uid in resource.data.participantUids);
      allow list: if isMember() && request.auth.uid in resource.data.participantUids;
      allow create: if isMember() &&
        request.resource.data.participantUids is list &&
        request.resource.data.participantUids.size() >= 2 &&
        request.resource.data.participantUids.size() <= 8 &&
        request.auth.uid in request.resource.data.participantUids;
      allow update: if isMember() &&
        request.auth.uid in resource.data.participantUids &&
        request.resource.data.participantUids == resource.data.participantUids;

      match /messages/{messageId} {
        allow read: if isMember() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow create: if isMember() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 5000;
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isMember() &&
        request.resource.data.recipientUid is string &&
        request.resource.data.read == false &&
        request.resource.data.type in ['mention', 'reference', 'reply', 'dm', 'approval', 'treaty', 'reaction', 'comment', 'report'] &&
        (!('kind' in request.resource.data) ||
          (request.resource.data.kind is string &&
            request.resource.data.kind.size() > 0 &&
            request.resource.data.kind.size() <= 40)) &&
        request.resource.data.summary is string &&
        request.resource.data.summary.size() <= 500 &&
        request.resource.data.href is string;
      allow update: if isSignedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read == true;
    }

    function treatyPath(treatyId) {
      return /databases/$(database)/documents/treaties/$(treatyId);
    }

    function treatyData(treatyId) {
      return get(treatyPath(treatyId)).data;
    }

    function canReadTreaty(treatyId) {
      return isAdmin() || (
        isMember() && exists(treatyPath(treatyId)) && (
          treatyData(treatyId).status == 'active' ||
          treatyData(treatyId).status == 'broken' ||
          request.auth.uid in treatyData(treatyId).readerUids ||
          (treatyData(treatyId).open == true &&
            treatyData(treatyId).status == 'pending' &&
            isCityOwner())
        )
      );
    }

    function treatyStatusMatches() {
      return (request.resource.data.partyCityIds.size() >= 2 && request.resource.data.status == 'active') ||
        (request.resource.data.partyCityIds.size() < 2 && request.resource.data.status == 'pending');
    }

    function cityMayAct(cityId) {
      return resource.data.open == true ||
        cityId == resource.data.proposerCityId ||
        cityId in resource.data.inviteeCityIds;
    }

    function validNewTreaty() {
      return isMember() &&
        ownsListedCity(request.resource.data.proposerCityId) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.currentRevision == 1 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.partyCityIds.size() == 1 &&
        request.resource.data.partyCityIds[0] == request.resource.data.proposerCityId &&
        request.resource.data.type in ['alliance', 'trade', 'non-aggression', 'other'] &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 160 &&
        request.resource.data.nature is string &&
        request.resource.data.nature.size() <= 8000 &&
        request.resource.data.terms is string &&
        request.resource.data.terms.size() <= 20000 &&
        request.resource.data.purpose is string &&
        request.resource.data.purpose.size() > 0 &&
        request.resource.data.purpose.size() <= 500 &&
        request.resource.data.open is bool &&
        request.resource.data.inviteeCityIds is list &&
        request.resource.data.inviteeCityIds.size() <= 24 &&
        request.resource.data.readerUids is list &&
        request.auth.uid in request.resource.data.readerUids &&
        request.resource.data.color is string &&
        request.resource.data.lastActionCityId == request.resource.data.proposerCityId;
    }

    function partyAccept() {
      return ownsListedCity(request.resource.data.lastActionCityId) &&
        cityMayAct(request.resource.data.lastActionCityId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['partyCityIds', 'status', 'updatedAt', 'lastActionCityId', 'partyOwnerUids', 'readerUids']) &&
        request.resource.data.partyCityIds.hasAll(resource.data.partyCityIds) &&
        request.resource.data.partyCityIds.hasAny([request.resource.data.lastActionCityId]) &&
        request.resource.data.partyCityIds.size() == resource.data.partyCityIds.size() + 1 &&
        treatyStatusMatches() &&
        request.resource.data.currentRevision == resource.data.currentRevision &&
        request.resource.data.proposerCityId == resource.data.proposerCityId;
    }

    function partyRemove() {
      return ownsListedCity(request.resource.data.lastActionCityId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['partyCityIds', 'status', 'updatedAt', 'lastActionCityId', 'partyOwnerUids', 'readerUids']) &&
        resource.data.partyCityIds.hasAll(request.resource.data.partyCityIds) &&
        resource.data.partyCityIds.hasAny([request.resource.data.lastActionCityId]) &&
        !(request.resource.data.lastActionCityId in request.resource.data.partyCityIds) &&
        request.resource.data.partyCityIds.size() == resource.data.partyCityIds.size() - 1 &&
        treatyStatusMatches() &&
        request.resource.data.currentRevision == resource.data.currentRevision &&
        request.resource.data.proposerCityId == resource.data.proposerCityId;
    }

    function counterRevision() {
      return ownsListedCity(request.resource.data.lastActionCityId) &&
        cityMayAct(request.resource.data.lastActionCityId) &&
        request.resource.data.currentRevision == resource.data.currentRevision + 1 &&
        request.resource.data.partyCityIds.size() == 1 &&
        request.resource.data.partyCityIds[0] == request.resource.data.lastActionCityId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.proposerCityId == resource.data.proposerCityId &&
        request.resource.data.open == resource.data.open &&
        request.resource.data.color == resource.data.color &&
        request.resource.data.inviteeCityIds.hasAll(resource.data.inviteeCityIds) &&
        request.resource.data.readerUids.hasAll(resource.data.readerUids) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 160 &&
        request.resource.data.type in ['alliance', 'trade', 'non-aggression', 'other'] &&
        request.resource.data.nature is string &&
        request.resource.data.terms is string &&
        request.resource.data.purpose is string &&
        request.auth.uid in request.resource.data.partyOwnerUids &&
        (!('expiresOn' in request.resource.data) || (request.resource.data.expiresOn is string && request.resource.data.expiresOn.size() <= 10)) &&
        (!('renewOn' in request.resource.data) || (request.resource.data.renewOn is string && request.resource.data.renewOn.size() <= 10));
    }

    function partyBreak() {
      return ownsListedCity(request.resource.data.lastActionCityId) &&
        resource.data.status == 'active' &&
        resource.data.partyCityIds.hasAny([request.resource.data.lastActionCityId]) &&
        !(request.resource.data.lastActionCityId in request.resource.data.partyCityIds) &&
        request.resource.data.partyCityIds.size() == resource.data.partyCityIds.size() - 1 &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['partyCityIds', 'status', 'updatedAt', 'lastActionCityId', 'partyOwnerUids', 'readerUids', 'brokenByCityId', 'breakNote']) &&
        request.resource.data.brokenByCityId == request.resource.data.lastActionCityId &&
        request.resource.data.breakNote is string &&
        request.resource.data.breakNote.size() > 0 &&
        request.resource.data.breakNote.size() <= 500 &&
        request.resource.data.currentRevision == resource.data.currentRevision &&
        request.resource.data.proposerCityId == resource.data.proposerCityId &&
        (
          (request.resource.data.partyCityIds.size() >= 2 && request.resource.data.status == 'active') ||
          (request.resource.data.partyCityIds.size() < 2 && request.resource.data.status == 'broken')
        );
    }

    match /treaties/{treatyId} {
      allow get: if canReadTreaty(treatyId);
      allow list: if isAdmin() ||
        (isMember() && resource.data.status == 'active') ||
        (isMember() && resource.data.status == 'broken') ||
        (isMember() && request.auth.uid in resource.data.readerUids) ||
        (isMember() && resource.data.open == true && resource.data.status == 'pending' && isCityOwner());
      allow create: if validNewTreaty();
      allow update: if isMember() && (isAdmin() || partyAccept() || partyRemove() || counterRevision() || partyBreak());
      allow delete: if isAdmin();

      match /revisions/{revId} {
        allow read: if canReadTreaty(treatyId);
        allow create: if isAdmin() || (
          isMember() &&
          ownsListedCity(request.resource.data.authorCityId) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.number is int &&
          request.resource.data.number == int(revId) &&
          request.resource.data.authorCityId is string &&
          (
            request.resource.data.number == 1 ||
            request.resource.data.number == treatyData(treatyId).currentRevision + 1
          ) &&
          (treatyData(treatyId).open == true ||
            request.resource.data.authorCityId == treatyData(treatyId).proposerCityId ||
            request.resource.data.authorCityId in treatyData(treatyId).inviteeCityIds)
        );
      }

      match /responses/{responseId} {
        allow read: if canReadTreaty(treatyId);
        allow create, update: if isMember() &&
          request.resource.data.cityId is string &&
          ownsListedCity(request.resource.data.cityId) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.decision in ['accept', 'decline', 'counter', 'withdraw', 'break'] &&
          request.resource.data.revision == treatyData(treatyId).currentRevision &&
          (treatyData(treatyId).open == true ||
            request.resource.data.cityId == treatyData(treatyId).proposerCityId ||
            request.resource.data.cityId in treatyData(treatyId).inviteeCityIds ||
            request.resource.data.decision == 'withdraw');
      }

      match /comments/{commentId} {
        allow read: if canReadTreaty(treatyId);
        allow create: if canReadTreaty(treatyId) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 8000;
        allow delete: if isAdmin() || (isMember() && resource.data.authorUid == request.auth.uid);
      }

      match /wiki_sections/{sectionId} {
        allow read: if canReadTreaty(treatyId);
        allow create, update: if isMember() &&
          (isAdmin() ||
            ownsListedCity(treatyData(treatyId).proposerCityId) ||
            request.auth.uid in treatyData(treatyId).partyOwnerUids) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 160 &&
          request.resource.data.body is string &&
          request.resource.data.body.size() <= 20000;
        allow delete: if isAdmin() ||
          (isMember() && ownsListedCity(treatyData(treatyId).proposerCityId));
      }
    }

    match /threads/{threadId} {
      allow read: if isMember();
      allow create: if isMember() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() <= 20000 &&
        request.resource.data.imageUrls is list &&
        request.resource.data.imageUrls.size() <= 6 &&
        request.resource.data.replyCount == 0;
      allow update: if isMember() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt', 'replyCount']) &&
          request.resource.data.replyCount == resource.data.replyCount + 1 &&
          request.resource.data.authorUid == resource.data.authorUid) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isMember() && resource.data.authorUid == request.auth.uid);

      match /replies/{replyId} {
        allow read: if isMember();
        allow create: if isMember() &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 8000 &&
          request.resource.data.imageUrls is list &&
          request.resource.data.imageUrls.size() <= 4;
        allow delete: if isAdmin() || (isMember() && resource.data.authorUid == request.auth.uid);

        match /emoji_reactions/{reactionId} {
          allow read: if isMember();
          allow create: if emojiReactionCreate(reactionId) &&
            exists(/databases/$(database)/documents/threads/$(threadId)/replies/$(replyId));
          allow delete: if emojiReactionDelete();
        }
      }
    }

    // --- Sim layer: world control ---------------------------------------

    match /sim_world/{docId} {
      allow read: if isViewer() && docId == 'current';
      allow create, update: if isFabricCommitter() && docId == 'current';
      allow delete: if false;
    }

    match /sim_counters/{docId} {
      allow read: if isAdmin() || isFabricService();
      allow create, update: if isFabricCommitter() && docId == 'log';
      allow delete: if false;
    }

    match /sim_fabric_status/{docId} {
      allow read: if isViewer() && docId == 'current';
      allow create, update: if isFabricService() && docId == 'current';
      allow delete: if false;
    }

    // --- Sim layer: dashboard read model (Phase 3) -----------------------
    // The snapshot is a disposable, public-tier projection (Phase 3 brief
    // §2.1/§3.4): members and guests read the identical doc; only the
    // fabric committer writes it, under a shape fence. A missing doc is a
    // legitimate state (client fallback reads), so delete is denied to
    // everyone — deletion-as-repair is the ops script's Admin-scope
    // recovery, not a rules path.
    function validSnapshot(data) {
      return data.asOfSeq is int && data.asOfSeq >= 0
        && data.cityCards is list
        && data.latestSummaries is list && data.latestSummaries.size() <= 10
        && data.openContestCards is list
        && (data.generatedByResolutionId == null || data.generatedByResolutionId is string)
        && (data.townHallCard == null || data.townHallCard is map)
        && data.updatedAt is timestamp;
    }

    match /sim_dashboard_snapshots/{docId} {
      allow read: if isViewer() && docId == 'current';
      allow create, update: if isFabricCommitter() && docId == 'current'
        && validSnapshot(request.resource.data);
      allow delete: if false;
    }

    // Dashboard prefs (Phase 3 brief §2.2/§5, Dana A.5): presentation
    // state, not world state — the one sim-prefixed collection a browser
    // writes, fenced to the owning FULL member (the full-member fence is
    // what excludes guests; a bare uid match would let a guest write
    // their own doc). Read is owner-only: nobody's layout is anyone
    // else's business. Element-level panel validation is not expressible
    // in rules (no list iteration); the client's normalization
    // (lib/dashboard/prefs.ts) is total, so a malformed entry degrades
    // to registry defaults rather than breaking the dashboard.
    function validPrefs(data) {
      return data.layoutVersion is int && data.layoutVersion >= 1
        && data.panels is list && data.panels.size() <= 64
        && (data.defaultCityId == null || data.defaultCityId is string)
        && data.updatedAt is timestamp;
    }

    match /sim_dashboard_prefs/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if isFullMember() && request.auth.uid == uid
        && validPrefs(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Trust assessments (Phase 3 brief §2.3/§11.3): per-user presentation
    // state — a member's own marks on published claims, never a system
    // verdict. Owner-written under the full-member fence; readable by
    // the owner and by members the owner lists in sharedWith (that view
    // only — it confers no other access). The fabric committer gets NO
    // write here (TC-P12(v)): assessments are the member's own hand
    // only, so no NPC or fabric path can mark a claim in anyone's view.
    // A claim's publisher has no read of anyone's marks on it. Per-mark
    // field validation (stance enum, note ≤ 500) is not expressible in
    // rules (no map-value iteration); the caps below are, and the
    // client (lib/trust in the exports/trust module) validates the rest.
    function validAssessments(data) {
      return data.marks is map && data.marks.size() <= 1000
        && data.sharedWith is list && data.sharedWith.size() <= 50
        && data.updatedAt is timestamp;
    }

    match /sim_trust_assessments/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.uid in resource.data.sharedWith);
      allow create, update: if isFullMember() && request.auth.uid == uid
        && validAssessments(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // --- Site operations: bug reports (Phase 3 §11.4) --------------------
    // Verbatim from bug-reporting-and-cd-design.md Appendix B, via the
    // bugs module's integration snippet (lib/bugs/firestore-rules.snippet
    // .txt in the module clone). Site-operations data, not world data.
    // Members file [CJ: members only]; a report is readable by its
    // reporter and by sheriffs/admins only; it never appears in any feed
    // or member export. The field allowlist + caps below are the design
    // §2.4 privacy boundary in rules form: no field outside this list
    // can be written by any client, so no private sim data or other
    // member's content can be smuggled into a record.
    function validBugReportCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'tryingToDo', 'whatHappened', 'expected', 'severity', 'kind',
          'screenshotPath',
          'route', 'surface', 'entityRef', 'buildId', 'asOfSeq',
          'browserFamily', 'osFamily', 'viewport',
          'reporterUid', 'reporterName', 'clientAt',
          'status', 'searchTokens', 'createdAt'
        ])
        && d.reporterUid == request.auth.uid
        && d.status == 'new'
        && d.tryingToDo is string && d.tryingToDo.size() > 0 && d.tryingToDo.size() <= 200
        && d.whatHappened is string && d.whatHappened.size() > 0 && d.whatHappened.size() <= 4000
        && (!('expected' in d) || (d.expected is string && d.expected.size() <= 2000))
        && d.severity in ['stops-me', 'its-wrong', 'annoying', 'tiny']
        && d.kind in ['looks-broken', 'number-wrong', 'didnt-save', 'wont-load', 'text', 'other', 'not-sure']
        && (!('screenshotPath' in d) || (d.screenshotPath is string
            && d.screenshotPath.matches('bug-reports/' + request.auth.uid + '/.*')))
        && (!('route' in d) || (d.route is string && d.route.size() <= 300))
        && (!('surface' in d) || d.surface in ['dashboard', 'city', 'log', 'forum', 'maps', 'market', 'wiki', 'other'])
        && (!('entityRef' in d) || (d.entityRef is string && d.entityRef.size() <= 120))
        && (!('buildId' in d) || (d.buildId is string && d.buildId.size() <= 80))
        && (!('asOfSeq' in d) || (d.asOfSeq is int && d.asOfSeq >= 0))
        && (!('browserFamily' in d) || (d.browserFamily is string && d.browserFamily.size() <= 40))
        && (!('osFamily' in d) || (d.osFamily is string && d.osFamily.size() <= 40))
        && (!('viewport' in d) || (d.viewport is map
            && d.viewport.keys().hasOnly(['w', 'h'])
            && d.viewport.w is int && d.viewport.h is int))
        && d.reporterName is string && d.reporterName.size() > 0 && d.reporterName.size() <= 100
        && (!('clientAt' in d) || d.clientAt is timestamp)
        && d.searchTokens is list && d.searchTokens.size() <= 80
        && d.createdAt == request.time;
    }

    // Reporter edit (design Appendix B / RPT-c): typed fields ONLY, and
    // only while the report is `new` or `needs-info`. The one status move
    // a reporter may make is answering a needs-info question, which
    // returns the report to `new` (lib/bugs/reports.ts
    // updateReporterReport). screenshotPath, context, identity, triage
    // and fix-link fields are not reporter-writable after create.
    function validBugReportReporterUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.reporterUid == request.auth.uid
        && resource.data.status in ['new', 'needs-info']
        && affected.hasOnly(['tryingToDo', 'whatHappened', 'expected', 'severity', 'kind', 'searchTokens', 'status'])
        && (!affected.hasAny(['status'])
            || (resource.data.status == 'needs-info' && request.resource.data.status == 'new'))
        && request.resource.data.tryingToDo is string
        && request.resource.data.tryingToDo.size() > 0 && request.resource.data.tryingToDo.size() <= 200
        && request.resource.data.whatHappened is string
        && request.resource.data.whatHappened.size() > 0 && request.resource.data.whatHappened.size() <= 4000
        && (!('expected' in request.resource.data)
            || (request.resource.data.expected is string && request.resource.data.expected.size() <= 2000))
        && request.resource.data.severity in ['stops-me', 'its-wrong', 'annoying', 'tiny']
        && request.resource.data.kind in ['looks-broken', 'number-wrong', 'didnt-save', 'wont-load', 'text', 'other', 'not-sure']
        && request.resource.data.searchTokens is list && request.resource.data.searchTokens.size() <= 80;
    }

    // Sheriff triage write (design §3.4 / RPT-c): triage fields, fix-link
    // fields, severity re-grade, and the mirrored canonicalStatus on
    // duplicates (lib/bugs/types.ts — RPT-h needs it on the record).
    // Reporter identity, typed text, context and createdAt are immutable
    // here too — a sheriff edits the triage layer, never the report.
    function validBugReportTriageUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly([
          'status', 'triageNote', 'duplicateOf', 'canonicalStatus',
          'severity', 'fixBranch', 'fixPrUrl', 'previewUrl',
          'shippedInBuild', 'updatedAt'
        ])
        && request.resource.data.status in ['new', 'seen', 'needs-info', 'accepted',
            'fixed-in-preview', 'shipped', 'duplicate', 'not-a-bug', 'wont-fix']
        && (!('triageNote' in request.resource.data)
            || (request.resource.data.triageNote is string && request.resource.data.triageNote.size() <= 2000))
        && (!('duplicateOf' in request.resource.data)
            || (request.resource.data.duplicateOf is string && request.resource.data.duplicateOf.size() <= 128))
        && (!('canonicalStatus' in request.resource.data)
            || request.resource.data.canonicalStatus in ['new', 'seen', 'needs-info', 'accepted',
                'fixed-in-preview', 'shipped', 'duplicate', 'not-a-bug', 'wont-fix'])
        && (!('severity' in request.resource.data)
            || request.resource.data.severity in ['stops-me', 'its-wrong', 'annoying', 'tiny'])
        && (!('fixBranch' in request.resource.data)
            || (request.resource.data.fixBranch is string && request.resource.data.fixBranch.size() <= 200))
        && (!('fixPrUrl' in request.resource.data)
            || (request.resource.data.fixPrUrl is string && request.resource.data.fixPrUrl.size() <= 500))
        && (!('previewUrl' in request.resource.data)
            || (request.resource.data.previewUrl is string && request.resource.data.previewUrl.size() <= 500))
        && (!('shippedInBuild' in request.resource.data)
            || (request.resource.data.shippedInBuild is string && request.resource.data.shippedInBuild.size() <= 80))
        && request.resource.data.updatedAt == request.time;
    }

    match /bug_reports/{reportId} {
      // Read: the reporter (their own loop-closure view) and sheriffs.
      // A guest reads nothing; a member reads nobody else's report —
      // including a canonical report linked from their duplicate (RPT-h:
      // they see its mirrored canonicalStatus field, never the record).
      allow read: if isAdmin()
        || (isFullMember() && resource.data.reporterUid == request.auth.uid);
      // Create: full members only — guests may NOT file [CJ ruling].
      allow create: if isFullMember() && validBugReportCreate();
      allow update: if (isFullMember() && validBugReportReporterUpdate())
        || (isAdmin() && validBugReportTriageUpdate());
      // Closed reports are kept; deletion is an Admin-SDK act, never a
      // client one (design Appendix B).
      allow delete: if false;
    }

    // --- Sim layer: city state ------------------------------------------

    // Phase 2 (brief §9.7): undo's snapshot restore deletes docs the
    // erased resolution created and recreates docs it destroyed — the
    // committer gains delete on every world-state surface the undo engine
    // may restore. Publications and intel are deliberately NOT in this
    // amendment: their never-delete posture stands (§9.7), and
    // resolutions touching them are undo-ineligible via S4 instead.
    match /sim_cities/{cityId} {
      allow read: if isViewer();
      allow create: if isFabricCommitter()
        && request.resource.data.factionId == cityId
        && request.resource.data.baseline.baselineHash is string;
      allow update: if isFabricCommitter();
      allow delete: if isFabricCommitter();

      match /structures/{structureId} {
        allow read: if isViewer();
        allow create, update: if isFabricCommitter();
        allow delete: if isFabricCommitter();
      }

      match /households/{householdId} {
        allow read: if isViewer();
        allow create, update: if isFabricCommitter();
        allow delete: if isFabricCommitter();
      }

      match /figures/{figureId} {
        allow read: if isViewer();
        allow create, update: if isFabricCommitter();
        allow delete: if isFabricCommitter();
      }

      match /corporations/{corpId} {
        allow read: if isViewer();
        allow create, update: if isFabricCommitter();
        allow delete: if isFabricCommitter();
      }

      match /laws/{lawId} {
        allow read: if isViewer();
        allow create, update: if isFabricCommitter();
        allow delete: if isFabricCommitter();
      }

      // Phase 4 Catalogue I assembly: F-09 writes versioned budget
      // authorization docs here; the subcollection had no match block
      // (every sibling — structures/households/figures/corporations/
      // laws — has one), so budget writes were denied by default.
      // Posture mirrors laws exactly: viewer read, committer writes.
      match /budgets/{budgetId} {
        allow read: if isViewer();
        allow create, update: if isFabricCommitter();
        allow delete: if isFabricCommitter();
      }

      // Phase 4 Chains assembly: R-32 fund records (prep SS5 A-3).
      // Fund terms are published at creation, so posture mirrors the
      // sibling subcollections exactly: viewer read, committer writes.
      match /funds/{fundId} {
        allow read: if isViewer();
        allow create, update: if isFabricCommitter();
        allow delete: if isFabricCommitter();
      }

      // Phase 4 Chains assembly: R-36 capacity project records —
      // public sim state, same sibling posture.
      match /projects/{projectId} {
        allow read: if isViewer();
        allow create, update: if isFabricCommitter();
        allow delete: if isFabricCommitter();
      }
    }

    match /sim_character_extensions/{characterId} {
      allow read: if isViewer();
      allow create, update: if isFabricCommitter();
      allow delete: if isFabricCommitter();
    }

    // --- Sim layer: the Log ----------------------------------------------
    // Phase 2 amendment (brief §9.2/§9.3): the lawful undo must be able to
    // ERASE — Log entries and manifests are committer-deletable, NEVER
    // updatable by any identity (an update path on history is the one door
    // that never opens). Reads are unchanged from Phase 1: the actor-view
    // rule is what keeps N-1 real — another member cannot read your
    // actor-private entries AT ALL, not merely "the UI hides them".
    // (Append-only as a TOTAL doctrine was the mechanism CJ struck down;
    // the surviving rules text is purged by the spec owners — P2-D1.)

    match /sim_log_entries/{entryId} {
      // The fabric branch is load-bearing, not a convenience: the undo
      // engine's restore transaction must READ the target's entries
      // (chain verification, brief §8.5) before it may delete them —
      // including actor-private ones, whose whole point is that no
      // member surface can read them. Fabric identities are the
      // trusted service layer (same posture as sim_resolutions §9.3);
      // member/guest visibility semantics are unchanged.
      allow read: if isFabricService()
        || (isViewer()
          && (resource.data.get('visibility', 'public') == 'public'
              || isAdmin()
              || (isFullMember()
                  && resource.data.get('actor', {}).get('memberId', '') == request.auth.uid)));
      allow create: if isFabricCommitter() && validNewLogEntry(entryId);
      allow update: if false;
      allow delete: if isFabricCommitter();
    }

    match /sim_resolutions/{resolutionId} {
      // Manifests hold full before/after snapshots of other members'
      // cities; the audit surface (Phase 8) reads them under its own
      // entitlement model. Phase 2 narrows the Phase 1 viewer read to
      // admin + fabric (brief §9.3).
      allow read: if isAdmin() || isFabricService();
      allow create: if isFabricCommitter();
      allow update: if false;
      allow delete: if isFabricCommitter();
    }

    // --- Sim layer: action intake (first client surface is Phase 4) -----

    match /sim_actions/{actionId} {
      allow read: if isAdmin() || isFabricService()
        || (isFullMember() && resource.data.actor.memberId == request.auth.uid)
        || (isFullMember()
            && request.auth.uid in resource.data.get('audienceUids', []));
      // Phase 2 tightening (brief §9.4): an action is born ONLY as
      // 'received', with preview/confirmation and all resolution fields
      // null. A member can no longer mint a born-'awaiting_confirmation'
      // action carrying a self-authored preview.
      allow create: if isFullMember()
        && request.resource.data.actor.memberId == request.auth.uid
        && request.resource.data.status == 'received'
        && request.resource.data.preview == null
        && request.resource.data.confirmation == null
        && request.resource.data.resolutionId == null
        && request.resource.data.firstLogSeq == null
        && request.resource.data.lastLogSeq == null;
      // The member confirmation (brief §9.4) — REPLACES the Phase 1 clause,
      // which pinned status to the PRE-transition value and so made
      // confirmation impossible for every action (P2-D7, a latent Phase 1
      // bug caught in Phase 2 design and proven by P2-G9's positive case):
      // the member may move ONLY awaiting_confirmation -> confirmed,
      // touching ONLY confirmation/status/updatedAt, and the confirmation
      // must be bound to the stored preview's hash. The fabric branch is
      // unchanged.
      allow update: if isFabricService()
        || (isFullMember()
            && resource.data.actor.memberId == request.auth.uid
            && resource.data.status == 'awaiting_confirmation'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['confirmation', 'status', 'updatedAt'])
            && request.resource.data.status == 'confirmed'
            && request.resource.data.confirmation.confirmedByUid == request.auth.uid
            && request.resource.data.confirmation.previewHash == resource.data.preview.previewHash);
      // The committer deletes the source action inside a lawful undo
      // (§8.5: the intake record of an erased resolution goes with it).
      allow delete: if isFabricCommitter();
    }

    // --- Sim layer: pending consequences (Phase 2, brief §9.5) -----------
    // The document is audience-scoped — but the pending's EXISTENCE is a
    // public Log fact (its creation entry is realm-public). The seed and
    // payloadSpec inside this doc therefore never face a non-audience
    // reader (Felix N3 discipline, enforced here).

    match /sim_pending_consequences/{pendingId} {
      allow read: if isAdmin() || isFabricService()
        || (isFullMember()
            && request.auth.uid in resource.data.get('audienceUids', []));
      allow create, update, delete: if isFabricCommitter();
    }

    // --- Sim layer: undo operations (Phase 2, brief §9.6) ----------------
    // A member asks; the fabric checks and executes. The completion proof
    // is content-free (counts + hashes only, §2.5) and this doc is the
    // ONLY surviving trace of an erased resolution. Deleted by nobody.

    match /sim_undo_operations/{opId} {
      allow read: if isAdmin() || isFabricService()
        || (isFullMember() && resource.data.requesterUid == request.auth.uid);
      allow create: if isFullMember()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.targetResolutionId is string
        && request.resource.data.dependencyReport == null
        && request.resource.data.completion == null;
      allow update: if isFabricService();
      allow delete: if false;
    }

    // --- Sim layer: stat allocation ---------------------------------------

    match /sim_stat_allocations/{cityId} {
      // Fabric read (Phase 4 allocation assembly, the P2-K16 pattern):
      // the dispatcher materializes the R-35 read-plan paths (this doc
      // + versions/v1) under the committer identity, and undo-restore
      // transactions re-read the commit's write set (§8.5) — neither
      // can work unless the fabric identity may read here. The branch
      // admits only the fabric identity; member/guest draft privacy is
      // unchanged (owner + admin, as landed).
      allow read: if isAdmin() || isFabricService() || simCityOwner(cityId);
      allow create: if isFabricCommitter()
        && request.resource.data.cityId == cityId
        && request.resource.data.status == 'not_started';
      // Owner draft saves: draft fields only; baseline, budget, and every
      // commit field are untouchable from a browser (field-equality checks).
      // Phase 4 narrowing (build-prep P4-K14, brief §3.3): owners may only
      // ever target 'draft'. 'commit_requested' is set by the committer
      // when queueing the confirmed allocate_season0 action — allocation
      // commit is a Resolution Event through the play loop, so the status
      // flip alone creates no queue item, no preview, and no Log entry.
      // Exactly one commit path exists.
      allow update: if isFabricCommitter()
        || (simCityOwner(cityId)
            && resource.data.status in ['not_started', 'draft']
            && request.resource.data.status in ['draft']
            && request.resource.data.baselineHash == resource.data.baselineHash
            && request.resource.data.baselineStats == resource.data.baselineStats
            && request.resource.data.pointBudget == resource.data.pointBudget
            && request.resource.data.commitActionId == resource.data.commitActionId
            && request.resource.data.committedSeq == resource.data.committedSeq
            && request.resource.data.committedByUid == resource.data.committedByUid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['allocations', 'spentPoints', 'draftVersion',
                           'draftHash', 'authorUid', 'status', 'updatedAt']));
      allow delete: if isFabricCommitter();

      match /versions/{version} {
        // Fabric read branch as on the parent doc (P2-K16 pattern):
        // read-plan materialization + undo-restore re-reads. Committed
        // versions stay viewer-readable via the commitSeq branch, as
        // landed; nothing else widens.
        allow read: if isAdmin() || isFabricService() || simCityOwner(cityId)
          || (isViewer() && resource.data.commitSeq != null);
        // Committer-only create (Phase 4, build-prep P4-K14): the first
        // version is a fabric write inside the allocation commit
        // transaction (brief §1.2). The Phase 1 owner-create clause is
        // removed — it was a second, unaudited route to a commit-shaped
        // record, and no client ever used it.
        allow create: if isFabricCommitter();
        allow update: if false;
        allow delete: if isFabricCommitter();
      }
    }

    // --- Sim layer: finance (Phase 4, brief step 4) ---------------------
    // Member accounts and bank deposits are written ONLY by the
    // committer inside Resolution Events (F-01 lazy-open included) —
    // no client write path exists for any identity. Reads follow
    // finance §1.2 / §2.7: an account is its owner's (plus admin, and
    // the fabric identity, which materializes read plans and re-reads
    // undo write sets under it — the P2-K16 pattern); a deposit is
    // readable by its depositor, by the bank's owner (the corporation
    // record's ownerMemberId is the one ownership fact a rule may
    // read), and by the fabric identity; company- and treasury-sourced
    // deposits are public records (§2.7). sim_bank_loans is a reserved
    // block: the loan record shape and its holder-read branches land
    // with Phase 5's loan handlers — until then only admin/fabric
    // reads and committer writes exist (fail-closed by construction).

    match /sim_member_accounts/{memberId} {
      allow read: if isAdmin() || isFabricService()
        || (isFullMember() && request.auth.uid == memberId);
      allow create, update, delete: if isFabricCommitter();
    }

    match /sim_bank_deposits/{depositId} {
      allow read: if isAdmin() || isFabricService()
        || (isFullMember()
            && resource.data.depositor is map
            && resource.data.depositor.get('kind', '') == 'personal'
            && resource.data.depositor.get('memberId', '') == request.auth.uid)
        || (isViewer()
            && resource.data.depositor is map
            && resource.data.depositor.get('kind', '') in ['company', 'treasury'])
        || (isFullMember()
            && resource.data.get('bankCityId', '') is string
            && resource.data.get('bankCorporationId', '') is string
            && exists(/databases/$(database)/documents/sim_cities/$(resource.data.bankCityId)/corporations/$(resource.data.bankCorporationId))
            && get(/databases/$(database)/documents/sim_cities/$(resource.data.bankCityId)/corporations/$(resource.data.bankCorporationId)).data.get('ownerMemberId', '') == request.auth.uid);
      allow create, update, delete: if isFabricCommitter();
    }

    match /sim_bank_loans/{loanId} {
      allow read: if isAdmin() || isFabricService();
      allow create, update, delete: if isFabricCommitter();
    }

    // --- Sim layer: legal cases (Phase 4, brief step 8) ------------------
    // Cases are opened ONLY by the committer inside Resolution Events
    // (R-18's fixed-class resolution opens the first ones) — no client
    // write path exists for any identity. Reads are viewer-wide: brief
    // §4.5 publishes the charges realm-wide and the case entries are
    // public Log entries. Case updates (status transitions, verdict
    // fields) arrive with Phase 7's tribunal build and stay
    // committer-only the same way.

    match /sim_cases/{caseId} {
      allow read: if isViewer();
      allow create, update, delete: if isFabricCommitter();
    }

    // --- Sim layer: trust (publications + intel) --------------------------

    match /sim_publications/{publicationId} {
      allow read: if (resource.data.visibility == 'members_and_guests' && isViewer())
        || (resource.data.visibility == 'members'
            && (isFullMember() || isAdmin()
                || resource.data.publisherUid == request.auth.uid));
      // Create-only for every identity, forever: supersede/retract are new
      // version docs (brief §1.7). The subject-city owner publishes;
      // businessId stays null until the Phase 4 corporation-ownership pass.
      allow create: if isFullMember()
        && request.resource.data.publisherUid == request.auth.uid
        && simCityOwner(request.resource.data.cityId)
        && request.resource.data.businessId == null
        && request.resource.data.visibility in ['members', 'members_and_guests']
        && request.resource.data.claims is list;
      allow update, delete: if false;
    }

    match /sim_intel_records/{intelId} {
      // Fabric read: the undo restore transaction re-reads every doc
      // in the target's write set (brief §8.5) — an intel record in
      // the set must be readable by the committer or no covert
      // resolution could ever be undone (P2-K16).
      allow read: if isFabricService()
        || isAdmin()
        || (isFullMember() && resource.data.collectorUid == request.auth.uid)
        || (isFullMember() && ownsListedCity(resource.data.collectorCityId));
      // No ref, no record: a logged means is a creation requirement, in rules.
      allow create: if isFabricCommitter()
        && request.resource.data.method.methodRef is string
        && request.resource.data.method.methodRef.size() > 0
        && request.resource.data.collectionResolutionId is string
        && request.resource.data.collectionResolutionId.size() > 0;
      allow update: if false;
      // Erasure is the undo engine's alone (CJ's N-1 ruling: espionage
      // and intel follow normal undo logic — see phase2-decisions.md
      // P2-K16). The committer deletes only inside a restore
      // transaction; everyone else's delete stays denied.
      allow delete: if isFabricCommitter();
    }
  }
}
