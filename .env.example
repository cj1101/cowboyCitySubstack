# =============================================================================
# Cowboy City Lore — environment variables
# Copy to .env.local for local development. Never commit .env.local.
#
# Vercel production only needs the seven NEXT_PUBLIC_FIREBASE_* values.
# Firebase Console → Project settings → Your apps → Web app.
# Add the Vercel domain (and any custom domain) under
# Authentication → Settings → Authorized domains before sharing the site.
# =============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cowboycityrealm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cowboycityrealm
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cowboycityrealm.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local emulator only. Leave unset on Vercel.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Optional, only for `npm run migrate` against a legacy database.
# The website itself does not use a service account.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
