# =============================================================================
# Cowboy City Lore — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Production (IONOS / suarezhouse.net):
#   - Copy this file to the server as .env.local before `npm run build`
#   - Add suarezhouse.net to Firebase Auth → Authorized domains
# =============================================================================

# --- Firebase Client SDK (public — safe for browser) ---
# From Firebase Console → Project Settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cowboycityrealm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cowboycityrealm
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cowboycityrealm.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=667575114868
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-YY1DK60FW8

# --- Firebase Admin SDK (server-only — migration script, never expose) ---
# Use Option A OR Option B (not both required, but one must be set for migrate)

# Option A: path to downloaded service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option B: inline credentials (useful when JSON file is inconvenient)
# FIREBASE_PROJECT_ID=cowboycityrealm
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@cowboycityrealm.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
