rules_version = '2';

// Released onto cowboycityrealm.firebasestorage.app (us-east1).
// The bucket was created in production mode, which denies every request
// until these rules are deployed. match /b/{bucket}/o applies to that bucket.
//
// Every photo path except users/{uid} calls firestore.exists or firestore.get.
// Those calls fail closed until the Cloud Storage for Firebase service agent
// has roles/firebaserules.firestoreServiceAgent on the project. The emulator
// grants that automatically. Production does not.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function authEmail() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isRootAdmin() {
      return authEmail() in ['charlie@suarezhouse.net', 'cjtheswimmer1101@gmail.com'];
    }

    function isConfigAdmin() {
      return authEmail() != '' &&
        firestore.exists(/databases/(default)/documents/config/admins) &&
        authEmail() in firestore.get(/databases/(default)/documents/config/admins).data.emails;
    }

    function isAdmin() {
      return isRootAdmin() || isConfigAdmin() ||
        (hasUserDoc() && userDoc().data.isAdmin == true);
    }

    function hasUserDoc() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isSuspended() {
      return hasUserDoc() && userDoc().data.status in ['suspended', 'removed'];
    }

    function isMember() {
      return isSignedIn() && !isSuspended();
    }

    function memberDocId(uid, factionId) {
      return uid + '_' + factionId;
    }

    function isFactionOwner(factionId) {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/faction_members/$(memberDocId(request.auth.uid, factionId))) &&
        firestore.get(/databases/(default)/documents/faction_members/$(memberDocId(request.auth.uid, factionId))).data.role == 'owner';
    }

    function ownsListedCity(factionId) {
      return isFactionOwner(factionId) || (
        firestore.exists(/databases/(default)/documents/factions/$(factionId)) &&
        firestore.get(/databases/(default)/documents/factions/$(factionId)).data.get('ownerUids', []).hasAny([request.auth.uid])
      );
    }

    function isImage(maxBytes) {
      return request.resource.size < maxBytes &&
        request.resource.contentType.matches('image/.*');
    }

    function isVideo(maxBytes) {
      return request.resource.size < maxBytes &&
        request.resource.contentType.matches('video/.*');
    }

    function isMedia(imageBytes, videoBytes) {
      return isImage(imageBytes) || isVideo(videoBytes);
    }

    function postDoc(postId) {
      return firestore.get(/databases/(default)/documents/posts/$(postId));
    }

    function canWritePostMedia(postId) {
      return isAdmin() ||
        !firestore.exists(/databases/(default)/documents/posts/$(postId)) ||
        postDoc(postId).data.authorUid == request.auth.uid ||
        isFactionOwner(postDoc(postId).data.factionId);
    }

    // Object reads require a signed-in user. Directory listing is admin-only.
    // Pages still show images and video through getDownloadURL token links,
    // which Firebase serves without evaluating these rules.
    match /factions/{factionId}/{fileName} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isMember() &&
        (ownsListedCity(factionId) || isAdmin()) &&
        isMedia(15 * 1024 * 1024, 100 * 1024 * 1024);
      allow delete: if isMember() && (ownsListedCity(factionId) || isAdmin());
    }

    match /posts/{postId}/{fileName} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isMember() &&
        canWritePostMedia(postId) &&
        isMedia(12 * 1024 * 1024, 100 * 1024 * 1024);
      allow delete: if isMember() && (isAdmin() || canWritePostMedia(postId));
    }

    match /characters/{characterId}/{fileName} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isMember() &&
        isImage(5 * 1024 * 1024) &&
        firestore.exists(/databases/(default)/documents/characters/$(characterId)) &&
        isFactionOwner(
          firestore.get(/databases/(default)/documents/characters/$(characterId)).data.factionId
        );
      allow delete: if isMember() &&
        firestore.exists(/databases/(default)/documents/characters/$(characterId)) &&
        (isFactionOwner(
          firestore.get(/databases/(default)/documents/characters/$(characterId)).data.factionId
        ) || isAdmin());
    }

    match /users/{uid}/{fileName} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isSignedIn() && request.auth.uid == uid && isImage(5 * 1024 * 1024);
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /threads/{threadId}/{fileName} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isMember() && isMedia(12 * 1024 * 1024, 100 * 1024 * 1024);
      allow delete: if isMember();
    }

    // Bug report screenshots (Phase 3 §11.4; bug-reporting design §2.2).
    // Reporter-picked images only, under the reporter's own prefix.
    // Readable by the owning reporter and sheriffs/admins — nobody else,
    // ever. (The snippet's isFullMember() is translated to this file's
    // landed member gate, isMember(): storage.rules carries no
    // accessLevel fence; the strict members-only fence lives on the
    // Firestore bug_reports record itself, and a screenshot object
    // without a rules-valid report pointing at it is inert.)
    match /bug-reports/{uid}/{reportId}/{fileName} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isMember()
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /realm/{fileName} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin() && isImage(15 * 1024 * 1024);
      allow delete: if isAdmin();
    }
  }
}
